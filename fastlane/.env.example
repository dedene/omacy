# Zenjoy 1Password account (Engineering vault lives here, not in the personal account).
OP_ACCOUNT=zenjoy.1password.com
OP_RELEASE_ENV_VAULT=Engineering
OP_RELEASE_ENV_ITEM=Zentty Release Environment

# Optional Omacy Sparkle private key. Default is the `omacy` Keychain item
# created by Sparkle's generate_keys --account omacy.
# OMACY_SPARKLE_PRIVATE_ED_KEY=
# OMACY_SPARKLE_PRIVATE_ED_KEY_FILE=

# App Store Connect API Key for match + notarization
# Generate at https://appstoreconnect.apple.com/access/integrations/api
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_FILEPATH=

# Match passphrase (same as Zentty — shared cert repo)
MATCH_PASSWORD=
