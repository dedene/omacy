diff --git a/src/utils/ansi.rs b/src/utils/ansi.rs
index 328d91d..39a06d6 100644
--- a/src/utils/ansi.rs
+++ b/src/utils/ansi.rs
@@ -33,6 +33,28 @@ pub enum ColorCode {
     Xterm(u8),
 }
 
+impl ColorCode {
+    /// RGB bytes this code would emit. Xterm indexes use hexterm's palette.
+    pub fn rgb(&self) -> (u8, u8, u8) {
+        match self {
+            ColorCode::Rgb(hex) => parse_rgb_hex(hex),
+            ColorCode::Xterm(n) => parse_rgb_hex(crate::utils::hexterm::xterm_to_hex(*n)),
+        }
+    }
+}
+
+fn parse_rgb_hex(hex: &str) -> (u8, u8, u8) {
+    let s = hex.trim_matches('#');
+    if s.len() < 6 {
+        return (0, 0, 0);
+    }
+    (
+        u8::from_str_radix(&s[0..2], 16).unwrap_or(0),
+        u8::from_str_radix(&s[2..4], 16).unwrap_or(0),
+        u8::from_str_radix(&s[4..6], 16).unwrap_or(0),
+    )
+}
