+fn pack_render_cells_into(
+    arena: &[EffectCharacter],
+    render_cells: &[u32],
+    out: &mut [PackedCell],
+    term_bg: [u8; 3],
+    width: usize,
+    height: usize,
+) {
+    const DEFAULT_INK: [u8; 3] = [255, 255, 255];
+    for internal_row in 0..height {
+        let abi_row = height - 1 - internal_row;
+        for col in 0..width {
+            let dst = &mut out[abi_row * width + col];
+            *dst = PackedCell::default();
+            let cell = render_cells[internal_row * width + col];
+            if cell == EMPTY_RENDER_CELL {
+                continue;
+            }
+            let vis = &arena[cell as usize].animation.current_character_visual;
+            let ink = vis
+                .fg_color_code
+                .as_ref()
+                .map(crate::utils::ansi::ColorCode::rgb)
+                .map(|(r, g, b)| [r, g, b])
+                .unwrap_or(DEFAULT_INK);
+            let orig_bg = vis
+                .bg_color_code
+                .as_ref()
+                .map(crate::utils::ansi::ColorCode::rgb)
+                .map(|(r, g, b)| [r, g, b]);
+
+            let (fg, bg, has_background) = if vis.reverse {
+                (orig_bg.unwrap_or(term_bg), Some(ink), true)
+            } else {
+                (ink, orig_bg, orig_bg.is_some())
+            };
+
+            if has_background {
+                let [r, g, b] = bg.expect("reverse always supplies a background");
+                dst.occupancy |= CELL_HAS_BACKGROUND;
+                dst.bg_r = r;
+                dst.bg_g = g;
+                dst.bg_b = b;
+                dst.bg_a = 255;
+            }
+
+            let glyph = vis.symbol.chars().next().filter(|&c| c != ' ' && c != '\0');
+            if let Some(ch) = glyph {
+                dst.occupancy |= CELL_HAS_GLYPH;
+                dst.glyph = ch as u32;
+                dst.fg_r = fg[0];
+                dst.fg_g = fg[1];
+                dst.fg_b = fg[2];
+                dst.fg_a = 255;
+            }
+        }
+    }
+}
