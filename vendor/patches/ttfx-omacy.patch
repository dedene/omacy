+    /// Tick one simulation step without assembling an ANSI frame.
+    /// `next_frame` remains `advance` plus `get_formatted_output_string`.
+    fn advance(&mut self, ctx: &mut EngineCtx) -> bool {
+        let previous = ctx.suppress_ansi;
+        ctx.suppress_ansi = true;
+        let going = self.next_frame(ctx).is_some();
+        ctx.suppress_ansi = previous;
+        going
+    }
